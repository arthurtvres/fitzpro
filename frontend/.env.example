# Onde a API responde.
#
# So e necessario quando o front e a API ficam em enderecos diferentes. Servindo
# o build pelo proprio backend (o caso padrao em producao), deixe sem definir:
# o front usa a mesma origem da pagina.
#
# Em desenvolvimento, sem definir, o front ja aponta para 127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000
